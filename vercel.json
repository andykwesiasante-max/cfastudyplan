{
  "version": 2,
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/src/(.*)",
      "destination": "/404.html"
    },
    {
      "source": "/build.js",
      "destination": "/404.html"
    },
    {
      "source": "/(.*)\\.map",
      "destination": "/404.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}